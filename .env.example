# =====================================================================
#  Utility Duniya Bot — v108 SLIM  ·  .env ka namuna
# =====================================================================
#  Ye file sirf EXAMPLE hai. Isme apne asli token / key MAT likho.
#
#  • Render par chala rahe ho  → ye values Render ke "Environment" tab me
#    daalo (file me nahi). Render me daali gayi values secret rehti hain.
#  • Apne laptop par test kar rahe ho → is file ki copy `.env` naam se
#    banao aur usme apni values bharo. `.env` git me kabhi nahi jaati
#    (.gitignore me hai).
#
#  Sirf pehle do (BOT_TOKEN, ADMIN_ID) ZAROORI hain. Baaki sab optional —
#  na bharo to bot defaults par theek chalta hai.
# =====================================================================


# ---------------------------------------------------------------------
#  1. ZAROORI
# ---------------------------------------------------------------------

# BotFather (@BotFather) se mila token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Aapki Telegram numeric ID — @userinfobot ko /start bhejo, wo bata dega
ADMIN_ID=123456789


# ---------------------------------------------------------------------
#  2. 📱 NUMBER INFO — aapki API (khali chhodo to built-in default chalega)
# ---------------------------------------------------------------------
MYNUM_API_URL=
MYNUM_API_KEY=
MYNUM_API_TIMEOUT=40


# ---------------------------------------------------------------------
#  3. 👪 FAMILY INFO — aapki API (khali chhodo to built-in default chalega)
# ---------------------------------------------------------------------
FAMINFO_API_URL=
FAMINFO_API_KEY=
FAMINFO_API_TIMEOUT=40

# 0 = Aadhaar hamesha masked (XXXX-XXXX-1234) — recommended
# 1 = poora ID dikhega
NUM_SHOW_FULL_IDS=0


# ---------------------------------------------------------------------
#  4. 🛡️ PREMIUM VAULT — data ka backup (bahut recommended)
# ---------------------------------------------------------------------
#  Render free plan par restart hote hi local file gayab ho jaati hai.
#  Vault har kuch der me encrypted backup GitHub + Telegram par bhejta
#  hai, aur bot uthte hi usse wapas le aata hai.

VAULT_ENABLED=on
VAULT_GITHUB_REPO=himanshu75919-coder/utility-duniya-bot

#  ⚠️ Backup ALAG branch me jaata hai — ise 'main' MAT karna, warna har
#     backup naya deploy trigger karega aur bot restart loop me fansega.
VAULT_GITHUB_BRANCH=vault-backup

#  GitHub ka Personal Access Token (repo write permission chahiye).
#  ⚠️ Agar logs me ye dikhe:
#        GitHub backup fail: HTTP 401 {"message": "Bad credentials"}
#     to iska matlab ye token purana / expire / galat hai — naya banao.
VAULT_GITHUB_TOKEN=

#  ⚠️ YE ZAROOR SET KARO. Khali chhoda to encryption key BOT_TOKEN se
#     banti hai — aur BotFather se token badalte hi purane backup padhe
#     nahi ja payenge. Koi bhi lamba password chalega.
VAULT_KEY=

VAULT_BACKUP_MINUTES=60
VAULT_BACKUP_CHAT_ID=


# ---------------------------------------------------------------------
#  5. Mode (webhook / polling)
# ---------------------------------------------------------------------
#  auto    = khud decide kare (Render ke liye best)
#  polling = zabardasti polling (laptop par test karte waqt yahi rakho)
WEBHOOK_MODE=auto
WEBHOOK_URL=
WEBHOOK_SECRET=

#  Render free instance 15 min baad so jaata hai. Bot apna hi /health
#  ping karke use jagaye rakhta hai.
BOT_SELF_URL=https://utility-duniya-bot.onrender.com


# ---------------------------------------------------------------------
#  6. Force-join channel (optional)
# ---------------------------------------------------------------------
#  Set karoge to user ko pehle channel join karna padega. Khali = off.
FORCE_CHANNEL=
FORCE_CHANNEL_LINK=


# ---------------------------------------------------------------------
#  7. Branding + misc
# ---------------------------------------------------------------------
OWNER_USERNAME=Supermannn_x
BRAND_TAG=@Supermannn_x

#  on = dono tools sabke liye free (koi VIP / credit nahi). Yahi default.
ALL_FREE=on

#  Extra admins (comma se alag): 111111,222222
ADMINS=


# ---------------------------------------------------------------------
#  8. Crash shield / memory  (inhe aam taur par haath mat lagao)
# ---------------------------------------------------------------------
#  v108 me bot ~62 MB par chalta hai, 512 MB ki limit se bahut neeche.
#  Ye sirf safety net hain.
MEMORY_LIMIT_MB=512
MEM_RESTART_MB=429
HANG_RESTART_SECONDS=900
MAX_CONCURRENT_UPDATES=8
CLEANUP_MINUTES=60
