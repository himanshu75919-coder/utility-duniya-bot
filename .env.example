# BotFather se milega (STEP 1)
BOT_TOKEN=paste_your_token_here

# Tumhari Telegram user ID (STEP 2) - @userinfobot se milegi
ADMIN_ID=paste_your_userid_here

# Force-join channel (STEP 3) - khali chhodo to ye band rahega
FORCE_CHANNEL=@YourChannelUsername
FORCE_CHANNEL_LINK=https://t.me/YourChannelUsername

# Premium payment ke liye tumhari UPI ID (STEP 5)
UPI_ID=yourname@upi
UPI_NAME=UtilityBot

# Render par deploy ke baad milega (STEP 4 me set karna)
WEBHOOK_URL=

# Settings (badalne ki zaroorat nahi)
FREE_LIMIT=15
REFER_NEED=5
