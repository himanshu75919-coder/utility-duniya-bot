# BotFather se milega (Telegram Bot Token)
BOT_TOKEN=paste_your_token_here

# Tumhari Telegram user ID (Admin ID) - @userinfobot se milegi
ADMIN_ID=paste_your_userid_here

# Force-join channel (Optional - khali chhodo to off rahega)
FORCE_CHANNEL=@YourChannelUsername
FORCE_CHANNEL_LINK=https://t.me/YourChannelUsername

# Premium payment ke liye tumhari UPI ID & Name
UPI_ID=yourname@upi
UPI_NAME=UtilityBot

# Render ya VPS par deploy ke baad webhook url (Polling ke liye khali rakhein)
WEBHOOK_URL=

# Settings
FREE_LIMIT=20
REFER_NEED=5
