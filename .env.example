# ===================================================================
#  Utility Duniya Super Bot — Environment Variables (v49)
#  Ye file Render ke "Environment" tab me daalni hoti hai (yahan sirf example hai)
# ===================================================================

# ---- ZAROORI (must set) ----
# BotFather se milega (Telegram Bot Token)
BOT_TOKEN=paste_your_token_here

# Tumhari Telegram user ID (Admin ID / OWNER) - @userinfobot se milegi
# ⚠️ v33: yahi ID "owner" maani jaati hai -> usko na daily limit lagti hai, na premium maanga jata hai
ADMIN_ID=paste_your_userid_here

# Extra admins (optional) — agar aapke dost/helper bhi payment verify karein
# Aise daalo (comma se alag): ADMINS=123456789,987654321
ADMINS=

# (OPTIONAL) Tutorial ka apna link — bot khud telegra.ph par page banata hai,
# par aap chaho to apna link (jaise channel post ya Google Doc) yahan daal do:
# TUTORIAL_URL=


# ---- OPTIONAL (basic) ----
# Force-join channel (khali chhodo to off rahega)
FORCE_CHANNEL=@YourChannelUsername
FORCE_CHANNEL_LINK=https://t.me/YourChannelUsername

# Premium payment ke liye tumhari UPI ID & Name
UPI_ID=yourname@upi
UPI_NAME=UtilityBot

# Webhook url (Polling use kar rahe ho to khali rakho)
WEBHOOK_URL=

# Limits / Credits (v37)
FREE_CREDITS=25       # naye user ko itne credits (ek baar ke) — premium tools ke liye
FREE_LIMIT=20         # purana daily-limit var (v36 tak) — ab use nahi hota, chhod do
REFER_NEED=5          # itne refer par free VIP

# ---- OPTIONAL (v31 PRO upgrades) ----

# Instagram downloader ko 100% reliable banane ke liye (recommended)
# Instagram app/web se apna sessionid cookie le lo -> yahan daal do
# (bina iske bhi chalta hai, par Instagram kabhi kabhi rate-limit kar deta hai)
IG_COOKIE=
# Ya cookies.txt file ka path (agar Render disk pe upload karo)
IG_COOKIES_FILE=

# Terabox direct link ke liye (2026 me public APIs band hain — ye 100% chalta hai)
# Apne throwaway Terabox account ka "ndus" cookie value daalo
TERABOX_COOKIE=
# Ya apna TeraDL provider base URL (jaise https://my-teradl.onrender.com)
TERABOX_API_BASE=
TERABOX_API_KEY=

# ---- v32 PHASE-3 (optional) ----

# 🌐 IP / Domain tool ke liye kuch set karne ki zaroorat nahi (free ip-api use hota hai)

# ---------- v57: 📱 NUMBER INFO — AAPKI API (direct) ----------
# Poori guide: NUMBER-INFO-API-SETUP.md
# numverify (free 100/month):  URL=https://apilayer.net/api/validate
#                              KEY_PARAM=access_key  PARAM=number
# abstractapi (free 250/month): URL=https://phonevalidation.abstractapi.com/v1/
#                              KEY_PARAM=api_key     PARAM=phone
NUMINFO_PROVIDER_URL=
NUMINFO_PROVIDER_KEY=
NUMINFO_PROVIDER_PARAM=number
NUMINFO_PROVIDER_KEY_PARAM=access_key
NUMINFO_PROVIDER_AUTH=query
NUMINFO_PROVIDER_TIMEOUT=12
NUMINFO_PROVIDER_METHOD=GET
# 🧪 DEMO mode: on karo to Number Info SAMPLE (dummy) card dikhata hai —
# bina API bhi dekh sakte ho ki aapki API lagne par kaisa aayega.
# Isme koi asli vyakti ka data nahi hota. (Telegram me /numdemo bhi chalta hai.)
NUMINFO_DEMO=off

NUM_INFO_API_BASE=https://osint-api-hub.onrender.com
NUM_INFO_API_KEY=Demo

# 🎙️ Voice Studio ke liye kuch nahi chahiye (edge-tts free hai, Microsoft neural voices)

# ---- v33 ADMIN + PAYMENT (optional) ----

# Screenshot check ke liye OCR (agar Render par available ho to aur strict ho jata hai)
# Normally zaroorat nahi — bina iske bhi aapke bot me UI/heuristic check chalta hai.
# Chaho to: pip install pytesseract + system me tesseract binary (Render me build command me daalni padegi)

# ---- v54.0: VEHICLE / RTO / CHALLAN tool PERMANENTLY REMOVED ----
# Live RC/challan ke liye LICENSED provider key chahiye thi (hub 410 "disabled",
# govt portals timeout/CAPTCHA) — isliye user order par tool hata diya gaya.
# Neeche ke VEHICLE_* vars ab kahin use NAHI hote; Render se bhi hata sakte ho.
# Official sources (user khud use kare): vahan.parivahan.gov.in · echallan.parivahan.gov.in

# ---- v41/v54: IMEI / PHONE DETAILS (TAC + FULL spec sheet + photo) ----
# v54 chain: /api/imei (TAC db) → /api/device-specs (nanoreview specs + photo).
# Khaali chhodo to HUB_API_BASE / HUB_API_KEY use hote hain (wahi hub).
IMEI_API_BASE=
IMEI_API_KEY=
IMEI_TIMEOUT=25
# device-specs call ka timeout (model-code par hub slow hota hai; 8s kaafi)
IMEI_SPEC_TIMEOUT=8
# YouTube/downloader ke liye cookies file (YouTube login-wale check ke liye) — path do:
YTDLP_COOKIES_FILE=

# (v54: VEHICLE_SHOW_MOBILE / VEHICLE_SHOW_IDS hata diye — vehicle tool removed)


# ---- v45: 🔌 API HUB (aapka apna hub — saare tools isi par shift ho jaate hain) ----
# Ye ek key lagate hi ye sab hub se chalne lagte hain:
#   🌐 IP/DOMAIN · 🏦 IFSC · 📮 PINCODE · ⚡ TERABOX · 📥 VIDEO DOWNLOADER (YouTube/X)
#   🆔 ID FINDER · 📜 KAGAZ (GST/PAN) · 🚗 VEHICLE · 📲 IMEI · 📱 NUMBER
# Hub ki default key "Demo" chalti hai (aapke hub par lifetime ALL-ENDPOINTS plan hai).
# Apni nayi key mil jaye to yahan badal do.
# Key na ho to bot purane free APIs par chalta rahega (kuch tootega nahi).
HUB_API_BASE=https://osint-api-hub.onrender.com/api
OSINT_API_BASE=https://osint-api-hub.onrender.com/api
HUB_API_KEY=Demo
# Hub poori tarah band karna ho:
HUB_ENABLED=on


# ---- v52: 🚀 SPEED — SELF-PING (free instance ko jaagte rakhta hai) ----
# Bot apna hi /health ping karta hai (Render LB ke through) -> 15-min sleep nahi hota
# -> cold start (30-60s) sirf pehli baar / deploy par. Baad me bot ~instant respond.
# (Render par RENDER_SERVICE_DNS_NAME khud milta hai, isliye ye optional hai —
#  par explicitly set kar dena best hai.)
BOT_SELF_URL=https://utility-duniya-bot.onrender.com


# ===================================================================
#  v60 — 🛡️ PREMIUM VAULT  (DATA KABHI NA KHOYE — YE ZAROOR BHARO)
# ===================================================================
# Aapka saara data (VIP premium users, payments, credits, referrals) ek local
# file `botdata.db` me rehta hai. Render ka FREE plan har deploy/restart par
# wo file DELETE kar deta hai. Isliye pehle premium users "delete" ho jaate the.
#
# v60 me ye PUKKA fix hai — kuch kharidne ki zaroorat NAHI. Bot apne aap
# encrypted backup banata hai (do jagah) aur boot par wapas MERGE karta hai.

# (a) TELEGRAM BACKUP — iske liye KUCH set karne ki zaroorat nahi.
#     Backup aapko bot se ek file ke roop me ADMIN_ID wali chat me milta hai.
#     Alag chat/channel chahiye to (bot ko us chat me admin/add karo):
# VAULT_BACKUP_CHAT_ID=-1001234567890

# (b) GITHUB BACKUP — offsite, AES-level encrypted (SHAKE256 + HMAC).
#     Repo public ho to bhi koi padh nahi sakta.
VAULT_GITHUB_REPO=himanshu75919-coder/utility-duniya-bot
# ⚠️ ZAROORI: backup branch 'main' NAHI honi chahiye! Warna har backup Render
#    ka naya deploy trigger karta aur bot ka infinite restart loop ban jata.
VAULT_GITHUB_BRANCH=vault-backup
# 🔑 GitHub token — Render ke Environment tab me daalo (SECRET):
VAULT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 🔑 (optional) apna encryption password. Khaali chhodo to BOT_TOKEN se banega.
VAULT_KEY=
# Kitne minute me auto-backup (min 5)
VAULT_BACKUP_MINUTES=30
# off = poora vault band (data phir safe NAHI rahega — off na karo)
VAULT_ENABLED=on

# ===================================================================
#  v60 — 🛡️ CRASH SHIELD
# ===================================================================
# Render free plan me sirf 512 MB RAM milti hai. Video + ffmpeg + PDF + Pillow
# ek saath chalein to process "Killed" ho jata hai (OOM). Memory watchdog
# 78% (400MB) par khud cache saaf karta hai.
MEMORY_LIMIT_MB=512
# Kitne minute baad purge/cleanup (default 45)
CLEANUP_MINUTES=45
# Bot "zinda" dikhe par jawab na de (hung event loop) — tab:
#   0   = sirf /health par report karega
#   600 = 10 minute se atka ho to bot khud restart hoga (clean restart > dead bot)
HANG_RESTART_SECONDS=0
